---
import "../styles/site.css";

const {
  title = "Gerald Hinson",
  description = "",
  showBrand = true
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <link rel="icon" type="image/png" href="/assets/img/cleanMugshot.png" />    
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css"
    />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect"
          href="https://fonts.gstatic.com"
          crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&display=swap"
          rel="stylesheet">
  </head>
  <body>
    <header class="site-header">
      <nav class="nav">
      <div class="brand-slot">
        {showBrand && (
          <a class="brand" href="/">Gerald, thus far</a>
        )}
      </div>
        <a href="/">about</a>
        <a href="/tech-blog/">biz/tech-blog</a>
        <a href="/faith-blog/">faith-blog</a>
        <a href="/projects/">projects</a>
        <a href="/repositories/">repos</a>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div>geraldhinson.com</div>
    </footer>
  </body>
</html>
