---
import BaseLayout from "../../layouts/BaseLayout.astro";

const modules = import.meta.glob("./*.md", { eager: true });

const posts = Object.entries(modules)
  .map(([path, post]) => {
    const slug = path.split("/").pop().replace(/\.md$/, "");
    return {
      ...post.frontmatter,
      url: `/tech-blog/${slug}/`
    };
  })
  .sort((a, b) => new Date(b.date) - new Date(a.date));
---

<BaseLayout title="Tech Blog | Gerald Hinson" description="Technical writing">
  <h1>biz/tech blog</h1>
  <p class="subtitle">thoughts on tech, biz, coffee, and other topics worthy of rumination</p>

  <ul class="post-list">
    {posts.map((post) => (
      <li>
        <a class="item-title" href={post.url}>{post.title}</a>
        <div class="item-caption">{post.description}</div>
        <div class="item-meta">
          {new Date(post.date).toLocaleDateString("en-US", {
            year: "numeric",
            month: "long",
            day: "numeric"
          })}
        </div>
      </li>
    ))}
  </ul>
</BaseLayout>
